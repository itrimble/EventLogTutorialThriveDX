# PostgreSQL Connection Details for Next.js Application
# These should match the environment variables set in docker-compose.yml for the 'db' service.
PGHOST=localhost
PGPORT=5432
PGDATABASE=eventlog_dev
PGUSER=eventlogger
PGPASSWORD=localdevpassword

# Optional: Base URL for your Next.js application's API
# Useful if your frontend needs to explicitly call its own backend API endpoints.
# NEXT_PUBLIC_API_BASE_URL=http://localhost:3000/api

# Optional: For NextAuth.js if you add authentication
# NEXTAUTH_URL=http://localhost:3000
# NEXTAUTH_SECRET= # Generate a strong secret for production: openssl rand -base64 32

# KQL Parser Configuration (Conceptual - if Wasm module needs specific env vars)
# KQL_PARSER_MODE=wasm # or 'mock' or 'real_simulated'
# KQL_WASM_PATH=/path/to/kql_parser.wasm
